{
  "components": {
    "schemas": {
      "CopilotSessionOut": {
        "properties": {
          "device_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Device Id"
          },
          "expires_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          },
          "principal": {
            "title": "Principal",
            "type": "string"
          },
          "tenant_id": {
            "format": "uuid",
            "title": "Tenant Id",
            "type": "string"
          }
        },
        "required": [
          "tenant_id",
          "principal",
          "device_id",
          "expires_at"
        ],
        "title": "CopilotSessionOut",
        "type": "object"
      },
      "CurrentUserResponse": {
        "properties": {
          "user_id": {
            "format": "uuid",
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "user_id"
        ],
        "title": "CurrentUserResponse",
        "type": "object"
      },
      "DeviceOut": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "key_expires_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Key Expires At"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "status",
          "created_at",
          "key_expires_at"
        ],
        "title": "DeviceOut",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "PairingOut": {
        "properties": {
          "api_key": {
            "title": "Api Key",
            "type": "string"
          },
          "device_id": {
            "format": "uuid",
            "title": "Device Id",
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          }
        },
        "required": [
          "device_id",
          "api_key",
          "expires_at"
        ],
        "title": "PairingOut",
        "type": "object"
      },
      "SettingsResponse": {
        "properties": {
          "locale": {
            "title": "Locale",
            "type": "string"
          }
        },
        "required": [
          "locale"
        ],
        "title": "SettingsResponse",
        "type": "object"
      },
      "SettingsUpdate": {
        "properties": {
          "locale": {
            "enum": [
              "nl",
              "fr",
              "ar",
              "en"
            ],
            "title": "Locale",
            "type": "string"
          }
        },
        "required": [
          "locale"
        ],
        "title": "SettingsUpdate",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WorkspaceResponse": {
        "properties": {
          "created": {
            "default": false,
            "title": "Created",
            "type": "boolean"
          },
          "tenant_id": {
            "format": "uuid",
            "title": "Tenant Id",
            "type": "string"
          }
        },
        "required": [
          "tenant_id"
        ],
        "title": "WorkspaceResponse",
        "type": "object"
      }
    }
  },
