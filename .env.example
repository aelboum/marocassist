# MarocAssist local development configuration. DEVELOPMENT ONLY.
#
# Do not copy this file by hand: run `./scripts/dev-env.sh`, which copies it
# to `.env` (gitignored) and replaces every `__GENERATE__` with a fresh
# random value. Never put a real (production or third-party) credential in
# either file, and never commit `.env`.

# --- Runtime ------------------------------------------------------------------
ENVIRONMENT=development

# --- PostgreSQL 16 (SaaS-OS consumer guide section 5: two roles) ---------------
POSTGRES_USER=marocassist
POSTGRES_PASSWORD=__GENERATE__
POSTGRES_DB=marocassist
APP_DB_USER=marocassist_app
APP_DB_PASSWORD=__GENERATE__
# Restricted application role (NOSUPERUSER NOBYPASSRLS). Used by backend and worker.
DATABASE_URL=postgresql+psycopg://marocassist_app:${APP_DB_PASSWORD}@db:5432/marocassist
# Privileged migration role. Used only by the `migrate` service.
MIGRATIONS_DATABASE_URL=postgresql+psycopg://marocassist:${POSTGRES_PASSWORD}@db:5432/marocassist

# --- Redis 7 (rate limiting, job queue) ------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Single origin (SaaS-OS ADR-0024) ----------------------------------------------
PUBLIC_APP_ORIGIN=http://localhost:8080
SAAS_OS_EDGE_PORT=8080
AUTH_POST_LOGIN_PATH=/dashboard
AUTH_COOKIE_SECURE=false

# --- OIDC (local ZITADEL) ------------------------------------------------------------
OIDC_ISSUER_URL=http://zitadel.localhost:8081
# Filled in once from `docker compose logs zitadel-bootstrap`.
OIDC_CLIENT_ID=
# Always empty: public PKCE client.
OIDC_CLIENT_SECRET=
OIDC_LOCAL_PROJECT_NAME=marocassist
OIDC_LOCAL_APPLICATION_NAME=marocassist-backend

# --- Local ZITADEL server --------------------------------------------------------------
ZITADEL_LOCAL_PORT=8081
# Exactly 32 characters (generated as 16 random bytes in hex).
ZITADEL_LOCAL_MASTERKEY=__GENERATE__
ZITADEL_DB_USER=zitadel
ZITADEL_DB_PASSWORD=__GENERATE__
ZITADEL_DB_NAME=zitadel
ZITADEL_FIRSTINSTANCE_ADMIN_USERNAME=admin
# ZITADEL's password policy needs upper and lower case, a digit and a symbol.
ZITADEL_FIRSTINSTANCE_ADMIN_PASSWORD=__GENERATE_PASSWORD__
ZITADEL_FIRSTINSTANCE_ADMIN_EMAIL=admin@marocassist.localhost

# --- Email (development: Mailpit, http://127.0.0.1:8025) -------------------------------
EMAIL_PROVIDER=mailpit
EMAIL_DEFAULT_SENDER=no-reply@marocassist.localhost

# --- MarocAssist product settings (backend/src/marocassist/config.py) ------------------
# Copilot device credential lifetime in seconds (300 to 43200, default 28800).
MAROCASSIST_COPILOT_KEY_TTL_SECONDS=28800
MAROCASSIST_COPILOT_MAX_DEVICES=3
