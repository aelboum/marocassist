{
  "manifest_version": 3,
  "name": "MarocAssist Copilot (development)",
  "short_name": "MarocAssist",
  "version": "0.1.0",
  "description": "Independent guidance in a side panel. Not affiliated with the Moroccan government. Never fills in or submits forms.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage", "scripting"],
  "optional_host_permissions": ["http://localhost:8090/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "MarocAssist Copilot"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
  }
}
